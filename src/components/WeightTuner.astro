---
// Dev-only. Lets you drag the two Fast Skim weights around and read off the
// pair that looks right, then hard-code it in global.css. The headline row
// swaps the hero between the three renderings so they can be compared.
const modes = [
  { id: 'normal', label: 'Normal' },
  { id: 'skim', label: 'Fast Skim' },
  { id: 'bold', label: 'Bold' },
];
---
{import.meta.env.DEV && (
  <aside class="tuner" aria-label="Fast Skim weight tuner">
    <header>
      <strong>Fast Skim weights</strong>
      <span class="tuner__dev">dev only</span>
    </header>

    <label>
      <span>Normal <output id="t-normal">400</output></span>
      <input type="range" id="r-normal" min="200" max="700" step="10" value="400" />
    </label>

    <label>
      <span>Bold <output id="t-bold">700</output></span>
      <input type="range" id="r-bold" min="400" max="900" step="10" value="700" />
    </label>

    <label>
      <span>Demo gap <output id="t-gap">30px</output></span>
      <input type="range" id="r-gap" min="0" max="96" step="2" value="30" />
    </label>

    <label>
      <span>Walk speed <output id="t-walk">120ms</output></span>
      <input type="range" id="r-walk" min="40" max="400" step="10" value="120" />
    </label>

    <fieldset class="tuner__modes" id="t-h1">
      <legend>Hero headline</legend>
      <div class="tuner__seg">
        {modes.map((m) => (
          <label class="tuner__mode">
            <input type="radio" name="h1mode" value={m.id} checked={m.id === 'skim'} />
            <span>{m.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <p class="tuner__css"><code id="t-css">--fs-normal: 400; --fs-bold: 700;</code></p>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const n = document.getElementById('r-normal');
        const b = document.getElementById('r-bold');
        const on = document.getElementById('t-normal');
        const ob = document.getElementById('t-bold');
        const g = document.getElementById('r-gap');
        const og = document.getElementById('t-gap');
        const w = document.getElementById('r-walk');
        const ow = document.getElementById('t-walk');
        const css = document.getElementById('t-css');

        // Route through the switch rather than setting the class by hand, so the
        // colour walk starts too.
        const ensureOn = () => {
          if (document.body.classList.contains('skim-on')) return;
          const t = document.querySelector('[data-skim-toggle]');
          if (!t) return;
          t.checked = true;
          t.dispatchEvent(new Event('change', { bubbles: true }));
        };

        const sync = () => {
          root.style.setProperty('--fs-normal', n.value);
          root.style.setProperty('--fs-bold', b.value);
          on.textContent = n.value;
          ob.textContent = b.value;
          css.textContent = `--fs-normal: ${n.value}; --fs-bold: ${b.value};`;
          // Nothing to see in the demo paragraph unless it is switched on.
          ensureOn();
        };
        n.addEventListener('input', sync);
        b.addEventListener('input', sync);

        // The gap has its own readout: it is a length, not a font weight.
        g.addEventListener('input', () => {
          root.style.setProperty('--skim-gap', g.value + 'px');
          og.textContent = g.value + 'px';
        });

        // Pace of the colour walk, and the tail length that goes with it. The
        // walk reads its own delay every tick, so dragging this retimes it live.
        const walk = (show) => {
          document.body.dataset.walkMs = w.value;
          root.style.setProperty('--walk-fade', w.value * 5 + 'ms');
          ow.textContent = w.value + 'ms';
          if (show) ensureOn();
        };
        w.addEventListener('input', () => walk(true));
        // Seed the pace without switching the demo on behind your back.
        walk(false);

        document.getElementById('t-h1').addEventListener('change', (e) => {
          document.body.dataset.h1 = e.target.value;
        });
      })();
    </script>
  </aside>
)}

<style>
  .tuner {
    position: fixed;
    right: 1rem;
    bottom: 6.5rem;
    z-index: 120;
    width: 232px;
    padding: .9rem 1rem 1rem;
    background: var(--card);
    border-radius: 16px;
    box-shadow: 0 0 0 1px var(--line), 0 16px 40px -16px #00000059;
    font-size: .82rem;
  }
  .tuner header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: .5rem;
    margin-bottom: .75rem;
  }
  .tuner__dev {
    font-size: .68rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--ink-faint);
  }
  .tuner label { display: block; margin-bottom: .6rem; }
  .tuner label > span {
    display: flex;
    justify-content: space-between;
    color: var(--ink-soft);
    margin-bottom: .2rem;
  }
  .tuner input[type='range'] { width: 100%; accent-color: var(--accent); }

  /* Segmented control for the three headline renderings. */
  .tuner__modes {
    border: 0;
    margin: .8rem 0 0;
    padding: 0;
    min-width: 0;
  }
  .tuner__modes legend {
    padding: 0;
    color: var(--ink-soft);
    margin-bottom: .3rem;
  }
  .tuner__seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    padding: 2px;
    background: var(--card-2);
    border-radius: 999px;
  }
  .tuner label.tuner__mode { margin: 0; min-width: 0; }
  .tuner__mode input { position: absolute; opacity: 0; width: 0; height: 0; }
  .tuner label.tuner__mode > span {
    display: block;
    text-align: center;
    padding: .3rem .1rem;
    margin: 0;
    border-radius: 999px;
    color: var(--ink-soft);
    cursor: pointer;
    white-space: nowrap;
    font-size: .72rem;
  }
  .tuner__mode input:checked + span {
    background: var(--card);
    color: var(--accent);
    font-weight: 700;
    box-shadow: 0 1px 3px #00000024;
  }
  .tuner__mode input:focus-visible + span { outline: 2px solid var(--accent); }

  .tuner__css {
    margin-top: .5rem;
    padding-top: .6rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
  }
  .tuner code { font-size: .72rem; word-break: break-all; }

  @media (max-width: 1100px) { .tuner { display: none; } }
</style>
