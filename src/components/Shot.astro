---
interface Props {
  src: string;
  alt: string;
  w: number;
  h: number;
  /* Transparent PNGs that already carry their own rounded corners. */
  plain?: boolean;
  class?: string;
}
const { src, alt, w, h, plain = false, class: className = '' } = Astro.props;
---
<figure class:list={['shot', plain && 'shot--plain', className]}>
  <img src={src} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
</figure>

<style>
  /* A slice of the app, not a whole phone. Keeps the cards from being 80%
     empty bezel. */
  .shot {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px #0000001a,
      0 18px 40px -18px #00000059;
    line-height: 0;
    max-width: 100%;
  }
  .shot img { width: 100%; height: auto; }

  /* Cut-out sheets and device mockups: the shadow has to follow the alpha
     channel, not a rectangle. */
  .shot--plain {
    border-radius: 0;
    overflow: visible;
    box-shadow: none;
    filter: drop-shadow(0 18px 30px #00000038);
  }
</style>
