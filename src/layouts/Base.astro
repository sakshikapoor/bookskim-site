---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const play = 'https://play.google.com/store/apps/details?id=com.wildkidstudio.bookskim';
const hire = 'https://sakshikapoor.com/';
const themes = [
  { id: 'light', label: 'Light' },
  { id: 'sepia', label: 'Sepia' },
  { id: 'dark', label: 'Dark' },
  { id: 'amoled', label: 'AMOLED' },
];
---
<!doctype html>
<html lang="en" data-theme="sepia">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ece2cf" />
    <link rel="icon" href={url("/assets/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("/assets/favicon-32.png")} sizes="32x32" />
    <link rel="apple-touch-icon" href={url("/assets/favicon-180.png")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/assets/favicon-512.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      try {
        const t = localStorage.getItem('bookskim-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      {import.meta.env.DEV && (
        <style is:inline>
  /* --- hire-me callout, placement variants ---
     Dev only. `body[data-hire]` picks one; the tuner panel sets it. The
     default is `footer`, which is what ships. --- */
  .hire-strip, .hire-link, .hire-pill, .hire-note { display: none; }

  /* strip: a thin line above the nav pill */
  .hire-strip {
    max-width: 1120px;
    margin: 0 auto .5rem;
    text-align: center;
  }
  .hire-strip a {
    display: inline-block;
    padding: .3rem 1rem;
    background: var(--card);
    border-radius: 999px;
    box-shadow: var(--shadow);
    color: var(--ink-soft);
    text-decoration: none;
    font-size: .88rem;
  }
  .hire-strip strong { color: var(--accent); }

  /* link: one more item in the nav row */
  .hire-link { color: var(--accent) !important; font-weight: 600; }

  /* pill: an outlined chip beside the Get it button */
  .hire-pill {
    padding: .35rem .8rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--accent);
    color: var(--accent);
    text-decoration: none;
    font-size: .88rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .hire-pill:hover { background: var(--accent); color: var(--card); }

  /* note: a handwritten aside hanging under the pill */
  .hire-note {
    position: absolute;
    top: 100%;
    right: max(1rem, calc(50% - 560px + 1.5rem));
    margin: .35rem 0 0;
    font-family: 'Caveat', cursive;
    font-size: 1.2rem;
    transform: rotate(-2deg);
  }
  .hire-note a { color: var(--accent); text-decoration: none; }
  .hire-note a:hover { text-decoration: underline; }

  body[data-hire='strip'] .hire-strip { display: block; }
  body[data-hire='link'] .hire-link { display: inline; }
  body[data-hire='pill'] .hire-pill { display: inline-flex; }
  body[data-hire='note'] .hire-note { display: block; }
  /* Only ever show one placement at a time. */
  body[data-hire]:not([data-hire='footer']) .foot__hire { display: none; }
        </style>
      )}
      {import.meta.env.DEV && (
        <div class="hire-strip">
          <a href={hire} target="_blank" rel="noopener">
            Looking for a design? <strong>Hire me!</strong>
          </a>
        </div>
      )}
      <div class="nav__pill">
        <a class="nav__brand" href={url("/")}>
          <img src={url("/assets/favicon-512.png")} alt="" width="34" height="34" />
          <span>BookSkim</span>
        </a>

        <nav class="nav__links" aria-label="Sections">
          <a href={url("/") + "#fast-skim"}>Fast Skim</a>
          <a href={url("/") + "#features"}>Features</a>
          <a href={url("/") + "#faq"}>FAQ</a>
          {import.meta.env.DEV && (
            <a class="hire-link" href={hire} target="_blank" rel="noopener">Hire me</a>
          )}
        </nav>

        <div class="nav__right">
          {import.meta.env.DEV && (
            <a class="hire-pill" href={hire} target="_blank" rel="noopener">Hire me!</a>
          )}
          <fieldset class="themes" id="themes">
            <legend class="sr-only">Reading theme</legend>
            {themes.map((t) => (
              <label class="themes__opt" data-theme-swatch={t.id}>
                <input type="radio" name="theme" value={t.id} checked={t.id === 'sepia'} />
                <span class="sr-only">{t.label}</span>
                <span class="themes__dot" aria-hidden="true"></span>
              </label>
            ))}
          </fieldset>

          <a class="btn btn--sm nav__cta" href={play}>Get it</a>
        </div>
      </div>

      {import.meta.env.DEV && (
        <p class="hire-note">
          <a href={hire} target="_blank" rel="noopener">looking for a design? hire me!</a>
        </p>
      )}
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__hire">
        <a class="hire" href={hire} target="_blank" rel="noopener">
          <span>Looking for a design?</span>
          <strong>Hire me!</strong>
        </a>
      </div>
      <div class="wrap foot__in">
        <div class="foot__brand">
          <img src={url("/assets/mascot.png")} alt="" width="72" height="75" />
          <div>
            <div class="foot__name">BookSkim</div>
            <p class="foot__tag">Free. Offline. Yours.</p>
          </div>
        </div>
        <nav class="foot__links" aria-label="Footer">
          <a href={play}>Google Play</a>
          <a href={url("/privacy/")}>Privacy</a>
          <a href="mailto:hello@wildkidstudio.in">hello@wildkidstudio.in</a>
        </nav>
      </div>
      <div class="wrap foot__fine">
        <span>&copy; {new Date().getFullYear()} WildKid Studio</span>
        <span class="note">made for people with a folder of EPUBs</span>
      </div>
    </footer>

    <div class="dock">
      <div class="dock__in">
        <img src={url("/assets/favicon-512.png")} alt="" width="38" height="38" />
        <div class="dock__text">
          <strong>BookSkim</strong>
          <span>EPUB reader with Fast Skim</span>
        </div>
        <a class="btn btn--sm" href={play}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.8a1 1 0 0 0-.5.9v18.6a1 1 0 0 0 .5.9l10-9.9-10-10.5Zm11.1 11.5-2.4 2.4 6.4 3.7c.6.3 1.3-.1 1.3-.8l-5.3-5.3ZM20 9.9l-2.4-1.4-2.9 2.9 2.4 2.4L20 12.4c.7-.4.7-1.4 0-2.5Zm-5.3-1.7L4.7 2.4l9.6 9.6 2.4-2.4-2-1.4Z"/></svg>
          Google Play
        </a>
      </div>
    </div>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        const bar = { light: '#eeebe4', sepia: '#ece2cf', dark: '#191817', amoled: '#000000' };
        const saved = (function () { try { return localStorage.getItem('bookskim-theme'); } catch { return null; } })();
        const current = saved && bar[saved] ? saved : 'sepia';

        root.dataset.theme = current;
        if (meta) meta.setAttribute('content', bar[current]);

        const input = document.querySelector('#themes input[value="' + current + '"]');
        if (input) input.checked = true;

        document.getElementById('themes')?.addEventListener('change', (e) => {
          const v = e.target.value;
          if (!bar[v]) return;
          root.dataset.theme = v;
          if (meta) meta.setAttribute('content', bar[v]);
          try { localStorage.setItem('bookskim-theme', v); } catch {}
        });
      })();
    </script>

    <style>
      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0 0 0 0);
        white-space: nowrap; border: 0;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: .5rem;
        background: var(--ink);
        color: var(--paper);
        padding: .6rem 1rem;
        border-radius: 999px;
        z-index: 200;
      }
      .skip:focus { left: 1rem; }

      /* --- floating pill navbar --- */
      .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        padding: .75rem 1rem 0;
      }

      .nav__pill {
        max-width: 1120px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--card);
        border-radius: 999px;
        box-shadow: var(--shadow);
        padding: .5rem .5rem .5rem 1rem;
        min-height: 60px;
      }

      .nav__brand {
        display: flex;
        align-items: center;
        gap: .6rem;
        text-decoration: none;
        font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
        font-weight: 800;
        font-size: 1.1rem;
        letter-spacing: -.02em;
        flex: none;
      }
      .nav__brand img { border-radius: 9px; }

      .nav__links {
        display: flex;
        gap: 1.6rem;
        margin-inline: auto;
        font-size: .97rem;
      }
      .nav__links a {
        text-decoration: none;
        color: var(--ink-soft);
        transition: color .18s ease;
      }
      .nav__links a:hover { color: var(--ink); }

      .nav__right {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex: none;
      }

      /* --- theme switcher: the app's four reading themes --- */
      .themes {
        display: flex;
        align-items: center;
        gap: .3rem;
        border: 0;
        margin: 0;
        padding: .28rem .4rem;
        background: var(--card-2);
        border-radius: 999px;
      }
      .themes__opt { cursor: pointer; display: grid; place-items: center; padding: 2px; }
      .themes__opt input {
        position: absolute;
        opacity: 0;
        width: 0; height: 0;
      }
      .themes__dot {
        width: 17px; height: 17px;
        border-radius: 50%;
        border: 1.5px solid var(--line);
        box-shadow: inset 0 0 0 1px #0000000d;
        transition: transform .18s ease, outline-color .18s ease;
        outline: 2px solid transparent;
        outline-offset: 2px;
      }
      [data-theme-swatch='light'] .themes__dot { background: #fdfbf6; }
      [data-theme-swatch='sepia'] .themes__dot { background: #ecdcbd; }
      [data-theme-swatch='dark'] .themes__dot { background: #2b2926; }
      [data-theme-swatch='amoled'] .themes__dot { background: #000; }

      .themes__opt input:checked + .sr-only + .themes__dot {
        outline-color: var(--accent);
        transform: scale(1.08);
      }
      .themes__opt input:focus-visible + .sr-only + .themes__dot {
        outline-color: var(--accent);
      }

      /* --- footer --- */
      .foot {
        border-top: 1px solid var(--line);
        padding-block: 3rem 2rem;
      }
      .foot__hire { margin-bottom: 2.5rem; }
      .hire {
        display: inline-flex;
        align-items: baseline;
        gap: .5rem;
        background: var(--card);
        border-radius: 999px;
        padding: .6rem 1.15rem;
        box-shadow: var(--shadow);
        color: var(--ink-soft);
        text-decoration: none;
        font-size: .97rem;
      }
      .hire strong {
        font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
        font-weight: 700;
        color: var(--accent);
      }
      .hire:hover strong { text-decoration: underline; }

      .foot__in {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
        justify-content: space-between;
      }
      .foot__brand { display: flex; align-items: center; gap: 1rem; }
      .foot__name {
        font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
      }
      .foot__tag { color: var(--ink-soft); }
      .foot__links { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: .97rem; }
      .foot__links a { color: var(--ink-soft); text-decoration: none; }
      .foot__links a:hover { color: var(--ink); text-decoration: underline; }
      .foot__fine {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1.5rem;
        align-items: baseline;
        justify-content: space-between;
        margin-top: 2.5rem;
        color: var(--ink-faint);
        font-size: .9rem;
      }

      /* --- sticky download dock --- */
      .dock {
        position: fixed;
        left: 0; right: 0; bottom: 0;
        z-index: 90;
        padding: .75rem 1rem calc(1.5rem + env(safe-area-inset-bottom));
        pointer-events: none;
      }
      .dock__in {
        max-width: 720px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        gap: .85rem;
        background: var(--card);
        border-radius: 999px;
        box-shadow: var(--shadow), 0 8px 30px -8px #0000002e;
        padding: .5rem .5rem .5rem 1rem;
        pointer-events: auto;
      }
      .dock__in > img { border-radius: 10px; flex: none; }
      .dock__text {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
        margin-right: auto;
        min-width: 0;
      }
      .dock__text strong {
        font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif;
        font-size: 1rem;
      }
      .dock__text span {
        font-size: .85rem;
        color: var(--ink-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      @media (max-width: 860px) {
        .nav__links { display: none; }
        .nav__pill { gap: .5rem; padding-left: .75rem; }
        .nav__right { margin-left: auto; }
      }

      @media (max-width: 520px) {
        .nav { padding: .5rem .75rem 0; }
        .nav__brand span { display: none; }
        .themes { padding: .22rem .3rem; }
        .themes__dot { width: 15px; height: 15px; }
        .dock__text span { display: none; }
        .dock__in { padding-left: .75rem; }
        .foot__in { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </body>
</html>
